# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Origin the Express server allows via CORS — must match whatever port Vite is
# actually serving the frontend on (npm run dev prints this).
CLIENT_ORIGIN=http://localhost:5173
